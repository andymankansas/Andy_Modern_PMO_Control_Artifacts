# Copy this file to .github/workflows/validate-<agent-slug>.yml at the REPOSITORY ROOT.
# Replace <Agent Name> and <agent-slug>, then commit.
name: Validate <Agent Name>

on:
  push:
    branches: [main]
    paths:
      - "agents/<agent-slug>/**"
      - ".github/workflows/validate-<agent-slug>.yml"
  pull_request:
    branches: [main]
    paths:
      - "agents/<agent-slug>/**"
      - ".github/workflows/validate-<agent-slug>.yml"

permissions:
  contents: read

jobs:
  test:
    runs-on: windows-latest
    defaults:
      run:
        working-directory: agents/<agent-slug>
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - name: Install dependencies
        run: python -m pip install -r requirements.txt
      - name: Run tests
        run: python -m pytest -q
